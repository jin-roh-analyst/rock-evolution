    <worksheet name='Top 10 Rock Artists per Year '>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#ffffff' fontname='Squealer' fontsize='24'>Top 10 Rock Artists in &lt;</run>
            <run fontcolor='#ffffff' fontname='Squealer' fontsize='24'>[Parameters].[Parameter 1]</run>
            <run fontcolor='#ffffff' fontname='Squealer' fontsize='24'>&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='master' name='federated.0uovn8r0qwx0a71d46e160xfm3k0' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Selected Year' datatype='integer' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='2010'>
              <calculation class='tableau' formula='2010' />
              <aliases>
                <alias key='1957' value='All Years' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0uovn8r0qwx0a71d46e160xfm3k0'>
            <column caption='Year, Selected Year' datatype='boolean' name='[Calculation_0952198432763905]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = 1957 THEN&#10;    TRUE&#10;ELSE&#10;    YEAR([date]) = [Parameters].[Parameter 1]&#10;END' />
            </column>
            <column caption='Is Rock' datatype='boolean' name='[Calculation_5160783474290690]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[genre_main] = &quot;Rock&quot;' />
            </column>
            <column caption='Rank per Year' datatype='integer' name='[Calculation_5160783815708677]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RANK(COUNT([__tableau_internal_object_id__].[master.csv_A41D26C67C6042FA99C40036D16CB489]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Rock Sub-Genre' datatype='string' name='[Calculation_5160783820410886]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS(LOWER([genres_raw]), &quot;metal&quot;) THEN &quot;Metal&quot;&#10;ELSEIF CONTAINS(LOWER([genres_raw]), &quot;soft&quot;) THEN &quot;Soft Rock&quot;&#10;ELSEIF CONTAINS(LOWER([genres_raw]), &quot;alternative&quot;) THEN &quot;Alternative Rock&quot;&#10;ELSEIF CONTAINS(LOWER([genres_raw]), &quot;hard&quot;) THEN &quot;Hard Rock&quot;&#10;ELSEIF CONTAINS(LOWER([genres_raw]), &quot;psychedelic&quot;) THEN &quot;Psychedelic Rock&quot;&#10;ELSEIF CONTAINS(LOWER([genres_raw]), &quot;folk&quot;) THEN &quot;Folk Rock&quot;&#10;ELSEIF CONTAINS(LOWER([genres_raw]), &quot;arena&quot;) THEN &quot;Arena Rock&quot;&#10;ELSEIF CONTAINS(LOWER([genres_raw]), &quot;progressive&quot;) THEN &quot;Progressive Rock&quot;&#10;ELSEIF CONTAINS(LOWER([genres_raw]), &quot;indie&quot;) THEN &quot;Indie Rock&quot;&#10;ELSEIF CONTAINS(LOWER([genres_raw]), &quot;grunge&quot;) THEN &quot;Grunge Rock&quot;&#10;ELSEIF CONTAINS(LOWER([genres_raw]), &quot;punk&quot;) THEN &quot;Punk Rock&quot;&#10;ELSE &quot;Other Rock&quot;&#10;END' />
            </column>
            <column caption='First Year' datatype='integer' name='[Calculation_5160784004489226]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [artist] : MIN(YEAR([date])) }' />
            </column>
            <column caption='Last Year' datatype='integer' name='[Calculation_5160784004648971]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [artist] : MAX(YEAR([date])) }' />
            </column>
            <column caption='Years Span' datatype='integer' name='[Calculation_5160784011784205]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_5160784004648971] - [Calculation_5160784004489226]' />
            </column>
